    {
      "parameters": {
        "jsCode": "// ALERT THROTTLING: one email per problem per hour, not one per failure.\n const err = $('Classify Error').first().json;\n const WINDOW_MINUTES = 60;\n const num = v => Number(String(v ?? '').replace(/,/g, ''));\n\nconst alertedRecently = $input.all().some(r =>\n r.json.Fingerprint === err.fingerprint &&\n r.json.Alerted === 'yes' &&\n err.epochMinute - num(r.json['Epoch Minute']) < WINDOW_MINUTES);\n\n// Critical errors email now (unless throttled); warnings wait for the daily digest.\n let alerted = 'digest only';\n if (err.severity === 'critical') alerted = alertedRecently ? 'throttled' : 'yes';\n\nreturn [{ json: { ...err, alerted, sendNow: alerted === 'yes' } }];"
      },
