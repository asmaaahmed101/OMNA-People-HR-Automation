    {
      "parameters": {
        "jsCode": "// Turn the raw error into a classified record: what broke, how bad it is, and what to do.\n const e = $input.first().json;\n const message = String(e.execution?.error?.message || e.trigger?.error?.message || 'No error message');\n const description = String(e.execution?.error?.description || e.trigger?.error?.description || '');\n const workflow = e.workflow?.name || 'Unknown workflow';\n const node = e.execution?.lastNodeExecuted || e.trigger?.node?.name || 'Trigger';\n const text = (message + ' ' + description).toLowerCase();\n\n// First matching rule wins, so the most specific rules come first.\n const rules = [\n { type: 'auth', severity: 'critical',\n pattern: /401|403|unauthori[sz]ed|forbidden|invalid_grant|invalid credentials|token (has )?expired|reauthori|access denied/,\n fix: 'Reconnect the credential used by this node (Credentials, then Reconnect), then retry the execution. Retrying alone will not help.' },\n { type: 'rate_limit', severity: 'warning',\n pattern: /429|rate limit|too many requests|quota|resource has been exhausted/,\n fix: 'Temporary. The next scheduled run usually succeeds. If it keeps happening, run the batch less often or upgrade the API plan.' },\n { type: 'network', severity: 'warning',\n pattern: /timeout|timed out|etimedout|econnreset|econnrefused|enotfound|socket hang up|\\b50[234]\\b|service unavailable|bad gateway/,\n fix: 'Temporary network or service problem. Retry the execution; check the service status page if it repeats.' },\n { type: 'ai_output', severity: 'warning',\n pattern: /output parser|could not parse|parseable|unexpected token|json|schema/,\n fix: 'The AI returned an unexpected format. Retry once; if it repeats, tighten the prompt or the output schema.' },\n { type: 'data', severity: 'critical',\n pattern: /cannot read propert|undefined|is not defined|not found|no column|missing|invalid syntax|expression|does not exist/,\n fix: 'Data or workflow bug. Open the execution, find the input that broke this node, fix the data or the expression, then retry.' },\n ];\n const rule = rules.find(r => r.pattern.test(text)) ||\n { type: 'unknown', severity: 'critical', fix: 'Unrecognised error. Open the execution and read the full error.' };\n\n// Business rule: anything failing in Intake affects candidates directly, so it is always critical.\n const severity = /intake/i.test(workflow) ? 'critical' : rule.severity;\n\nreturn [{ json: {\n time: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'),\n epochMinute: Math.floor(Date.now() / 60000),\n workflow, node, type: rule.type, severity,\n message: message.slice(0, 500), fix: rule.fix,\n executionId: String(e.execution?.id ?? ''),\n executionUrl: e.execution?.url || '',\n fingerprint: [workflow, node, rule.type].join(' | '),\n } }];"
      },
