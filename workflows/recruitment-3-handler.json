    {
      "parameters": {
        "jsCode": "\n// DAILY DIGEST: one summary of the last 24 hours plus everything still open.\n\nconst num = v => Number(String(v ?? '').replace(/,/g, ''));\nconst nowMin = Math.floor(Date.now() / 60000);\n\nconst rows = $input.all().map(i => i.json).filter(r => r.Fingerprint);\n\nconst last24 = rows.filter(r => nowMin - num(r['Epoch Minute']) <= 1440);\n\nconst open = rows.filter(r => String(r.Status || '').toLowerCase() === 'open');\n\nconst count = (list, key) => list.reduce((acc, r) => {\n  acc[r[key]] = (acc[r[key]] || 0) + 1;\n  return acc;\n}, {});\n\nconst byType = Object.entries(count(last24, 'Type'))\n  .sort((a, b) => b[1] - a[1]);\n\nconst groups = Object.values(open.reduce((acc, r) => {\n  acc[r.Fingerprint] = acc[r.Fingerprint] || { ...r, times: 0 };\n  acc[r.Fingerprint].times++;\n  return acc;\n}, {}));\n\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst typeRows = byType.map(([t, n]) =>\n  `<li><b>${esc(t)}</b>: ${n}</li>`\n).join('') || '<li>None</li>';\n\nconst openRows = groups.map(g =>\n  `<li><b>${esc(g.Workflow)}</b> at ${esc(g.Node)} (${esc(g.Type)}, ${esc(g.Severity)}) &times;${g.times}<br><span style=\"color:#6b7280;\">${esc(g.Message)}</span><br><i>${esc(g['Suggested Fix'])}</i></li>`\n).join('');\n\nreturn [{\n  json: {\n    hasNews: last24.length > 0 || open.length > 0,\n    total24h: last24.length,\n    critical24h: last24.filter(r => r.Severity === 'critical').length,\n    openCount: open.length,\n    typeListHtml: typeRows,\n    openListHtml: openRows || '<li>Nothing open. Good job.</li>',\n  }\n}];\n"
      },
