      "parameters": {
        "formTitle": "Job Application Form – DataNile",
        "formDescription": "Thank you for your interest in joining DataNile!\n\nPlease complete the application form, select your preferred position, explain why you want to join our team, and upload your latest CV in PDF format.\n\nOur recruitment team will review your application and contact shortlisted candidates.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Position",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "AI Automation Engineer (Junior)"
                  },
                  {
                    "option": "Data Analyst"
                  },
                  {
                    "option": "Customer Support Specialist"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Why do you want this job?",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "CV",
              "fieldType": "file",
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -976,
        -192
      ],
      "id": "0e9ce955-8cbf-4864-933c-bd84b9474b3b",
      "name": "Apply for a job",
      "webhookId": "033ece1f-10ed-4567-a149-5c0f3b21b4ca"
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\nconst f = item.json;\n\nconst errors = [];\n\n// 1. Validate Full Name\nconst name = String(f['Full Name'] || '')\n  .trim()\n  .replace(/\\s+/g, ' ');\n\nif (\n  name.length < 3 ||\n  name.split(' ').length < 2 ||\n  !/^[\\p{L} .'-]+$/u.test(name)\n) {\n  errors.push(\n    'Please enter your full name (first and last name, letters only).'\n  );\n}\n\n// 2. Validate Email\nconst email = String(f.Email || '')\n  .trim()\n  .toLowerCase();\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) {\n  errors.push('Please enter a valid email address.');\n}\n\n// 3. Validate Position\nconst position = f.Position;\n\nconst allowed = [\n  'AI Automation Engineer (Junior)',\n  'Data Analyst',\n  'Customer Support Specialist'\n];\n\nif (!allowed.includes(position)) {\n  errors.push('Please choose one of the listed positions.');\n}\n\n// 4. Validate Motivation\nconst motivation = String(\n  f['Why do you want this job?'] || ''\n).trim();\n\nif (motivation.length > 1500) {\n  errors.push(\n    'Please keep your motivation under 1500 characters.'\n  );\n}\n\n// 5. Validate CV File\nif (!item.binary || !item.binary.CV) {\n  errors.push('Please attach your CV.');\n} else {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'CV');\n\n  // Check actual PDF file signature\n  if (buf.subarray(0, 5).toString() !== '%PDF-') {\n    errors.push(\n      'Your CV must be a real PDF file (renaming a Word file to .pdf does not work).'\n    );\n  }\n\n  // Maximum file size: 5 MB\n  if (buf.length > 5 * 1024 * 1024) {\n    errors.push('Your CV must be smaller than 5 MB.');\n  }\n\n  // Minimum file size: 500 bytes\n  if (buf.length < 500) {\n    errors.push(\n      'Your CV file looks empty or damaged. Please export it again.'\n    );\n  }\n}\n\n// 6. Return Validation Result\nreturn [\n  {\n    json: {\n      name,\n      email,\n      position,\n      motivation,\n      valid: errors.length === 0,\n      errors,\n      errorText: errors.map(e => '- ' + e).join('\\n')\n    },\n    binary: item.binary\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
