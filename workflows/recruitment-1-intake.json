    {
      "parameters": {
        "jsCode": "\nconst sub = $('validate Submission').first();\n\nconst duplicate = $input.all().some(r =>\n  String(r.json.Email || '').trim().toLowerCase() === sub.json.email &&\n  String(r.json.Position || '').trim() === sub.json.position\n);\n\nreturn [\n  {\n    json: {\n      ...sub.json,\n      duplicate\n    },\n    binary: sub.binary\n  }\n];\n"
      },
